POSTGRES_DB=jobtracker
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=change_me
MONGO_INITDB_DATABASE=jobtracker
INTERNAL_TOKEN=change_me_too
# JWTs are signed and verified with HS512, which requires a secret of at least 64 bytes.
JWT_SECRET=change_me_to_a_64_byte_random_secret_for_hs512_jwt_signing_please
JWT_EXPIRY_DAYS=7
# Real key from https://console.anthropic.com - required for resume analysis and job-fit
# recommendations (scraper service). Without it, those features degrade gracefully to a
# "not configured" message rather than erroring.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
