POSTGRES_DB=jobtracker
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=change_me
MONGO_INITDB_DATABASE=jobtracker
INTERNAL_TOKEN=change_me_too
SCRAPER_TOKEN=change_me_three
# HS512 signing needs a secret of at least 64 bytes.
JWT_SECRET=change_me_to_a_64_byte_random_secret_for_hs512_jwt_signing_please
JWT_EXPIRY_DAYS=7
# AI for resume analysis, job-fit recommendations, and offer comparison. Optional: left blank, those
# features are hidden, not errored. Any call costs money on the provider account you set here.
#   AI_PROVIDER is the tool: anthropic, openai, gemini, mistral, deepseek, groq, xai, openrouter,
#     or a model on this machine: ollama, lmstudio (no key needed).
#   AI_API_KEY from that tool's console. AI_MODEL is required, except anthropic (claude-sonnet-5).
#   AI_BASE_URL only when the tool isn't at its usual address, such as Ollama on another machine.
#   Ollama: raise OLLAMA_CONTEXT_LENGTH; its 2048-token default cuts a resume off.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Email reminders (daily digest, interview soon, offer deadline, follow up). Optional: left blank,
# nothing is sent and Profile > Notifications says so. Any SMTP account works; for Gmail use
# smtp.gmail.com, port 587, your address as SMTP_USERNAME and SMTP_FROM, and an app password
# (Google account > Security > App passwords) as SMTP_PASSWORD, never your real one.
#   Port 465 connects over TLS; any other port upgrades to TLS when the server offers it.
#   APP_URL is the link at the foot of each email; set it if you open the app at another address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
APP_URL=

# Registration closes once the first account exists, so nobody else who can reach the app can sign up.
# Set to true to allow another account, then back to false.
REGISTRATION_OPEN=false

# The app checks GitHub once a day for a newer release and shows a link when one exists.
# Set to false to stop it making that call.
UPDATE_CHECK=true

# The port the app answers on, http://localhost:5173 by default. Change it if something else already
# uses 5173 (a Vite dev server does), then run "docker compose up -d" again.
WEB_PORT=5173

# Hosting it for use beyond this machine. See "Hosting it" in README.md first.
#   BIND_ADDRESS: 127.0.0.1 keeps the app on this machine. 0.0.0.0 opens it to your network, or to the
#     internet on a server; do that only behind https.
#   TRUSTED_PROXIES: how many proxies sit in front of the app (Cloudflare Tunnel, Caddy, Traefik: 1).
#     Wrong, and every visitor looks like the proxy, so one person guessing passwords locks out the rest.
#   REQUESTS_PER_MINUTE: per visitor, against floods; far above real use.
#   AI_DAILY_LIMIT: AI calls a day across the app, a cap on your AI bill. 0 for no cap. One call that
#     searches the web (company brief, market check) may run up to 4 searches, which the provider bills apart.
#   HSTS: true once the app has https on a real domain, so browsers never use plain http for it.
#     Never on localhost: browsers would then refuse http for every app you run there.
BIND_ADDRESS=127.0.0.1
TRUSTED_PROXIES=0
REQUESTS_PER_MINUTE=600
AI_DAILY_LIMIT=100
HSTS=false
