{
  // The app's settings over src and test together. vitest never type-checks, so without this a test
  // fixture can drift from the types it stands in for and still pass. Run by `npm run typecheck` and CI.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src", "test"]
}
