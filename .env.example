POSTGRES_DB=jobtracker
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=change_me
MONGO_INITDB_DATABASE=jobtracker
INTERNAL_TOKEN=change_me_too
# HS512 signing needs a secret of at least 64 bytes.
JWT_SECRET=change_me_to_a_64_byte_random_secret_for_hs512_jwt_signing_please
JWT_EXPIRY_DAYS=7
# Anthropic key (console.anthropic.com) for resume analysis and job-fit recommendations.
# Optional: without it those features are hidden, not errored.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# The app checks GitHub once a day for a newer release and shows a link when one exists.
# Set to false to stop it making that call.
UPDATE_CHECK=true
