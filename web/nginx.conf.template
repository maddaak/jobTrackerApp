server {
    listen 443 ssl;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/localhost.pem;
    ssl_certificate_key /etc/nginx/certs/localhost-key.pem;

    # Default 1MB limit would reject resume uploads. Above the 10MB file limit on core/BFF, so a
    # 10MB file plus its multipart framing is refused there with a real message, not by nginx.
    client_max_body_size 11M;

    # Opening an attachment is a browser navigation, so it sends Accept: text/html and the SPA
    # rewrite below would answer with the app shell instead of the file. No client route lives
    # under /jobs, so there is nothing here for that rewrite to serve. Must stay above it: nginx
    # takes the first matching regex location.
    location ~ ^/jobs/[0-9]+/images {
        proxy_pass http://bff:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/(auth|health|jobs|interviews|metrics|scrape|resumes|ai-status|update-status) {
        # Client routes (/metrics, /resumes) collide with API paths; a browser refresh sends Accept: text/html, so serve the SPA for those.
        if ($http_accept ~* text/html) {
            rewrite ^ /index.html last;
        }
        proxy_pass http://bff:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Never cache index.html: it points at the current hashed bundle, so a stale copy hides deploys.
    location = /index.html {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-cache";
    }

    location /assets/ {
        root /usr/share/nginx/html;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
